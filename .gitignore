# Runtime output (generated by scripts)
*.json
!references/config/*.json

# Archlint architecture baseline — tracked: Gate 6 diff mode compares new
# violations against this committed snapshot (regenerate: archlint snapshot -o)
!.architecture-baseline.json

# UI manifests/configs — tracked so the app is buildable from a clone
!ui/package.json
!ui/package-lock.json
!ui/tsconfig.json
!ui/tsconfig.app.json
!ui/tsconfig.node.json

# Backup directories (generated by create-restore-point.ps1)
backup-*/

# Pester / coverage test artifacts
test-results/
coverage.xml
testResults.xml
cov-*.xml
coverage-*.xml
coverage/
tests-run.log
*.bak

# Local tooling caches (auto-regenerated, not source)
.qoder/
.quality-history.jsonl
.sprint.diff

# Personal development-process notes (kept local, not part of the published
# project; Gate 11 reads sprint state from disk, which is unaffected)
.sprint-state/
.session-learnings.md
.code-walkthrough-result.json
.xp-gate/

# Delphi review intermediate artifacts
.delphi-work/

# WorkBuddy agent workspace data (memory, session artifacts)
.workbuddy/

# Toolchain manifest for the ROOT vitest run (Gate 5 also executes
# `npx vitest run` from the repo root). It is tracked on purpose: the root run
# is part of the gate chain, so a clone must be able to install the toolchain
# that run needs. `ui/package.json` stays the authority for the UI toolchain.
!package.json
!package-lock.json

# Drill run artifacts. The drill scripts themselves are ALSO untracked since
# 2026-10-20 (original 2026-10-07 decision finally enforced): they create real
# services / Machine PATH / HKLM objects and must not ship in a public repo.
# They live only on the drill machine; cloners get nothing here.
wrc-drill/

# TypeScript incremental build caches (regenerated; stale copies poison tsc -b)
*.tsbuildinfo

# Worktree directories (sprint-flow isolation)
.worktrees/

# OS files
Thumbs.db
desktop.ini
.DS_Store

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# PowerShell
*.pdb

# local verification/walkthrough scaffolding (never commit)
.wrc-*
