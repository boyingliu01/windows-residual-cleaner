# Runtime output (generated by scripts)
*.json
!references/config/*.json

# UI manifests/configs — tracked so the app is buildable from a clone
!ui/package.json
!ui/package-lock.json
!ui/tsconfig.json
!ui/tsconfig.app.json
!ui/tsconfig.node.json

# Backup directories (generated by create-restore-point.ps1)
backup-*/

# Pester / coverage test artifacts
test-results/
coverage.xml
testResults.xml
cov-*.xml
coverage-*.xml
tests-run.log
*.bak

# Local tooling caches (auto-regenerated, not source)
.qoder/
.quality-history.jsonl
.sprint.diff

# Delphi review intermediate artifacts
.delphi-work/

# WorkBuddy agent workspace data (memory, session artifacts)
.workbuddy/

# Drill run artifacts (drill scripts themselves ARE tracked)
wrc-drill/drill5-work/
wrc-drill/admin-out.txt
wrc-drill/admin-err.txt

# TypeScript incremental build caches (regenerated; stale copies poison tsc -b)
*.tsbuildinfo

# Worktree directories (sprint-flow isolation)
.worktrees/

# OS files
Thumbs.db
desktop.ini
.DS_Store

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# PowerShell
*.pdb
